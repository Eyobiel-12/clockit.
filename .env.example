# Kopieer naar .env en pas aan. Zonder .env gebruikt docker compose deze standaardwaarden.
DB_NAME=clockit
DB_USER=clockit
DB_PASSWORD=clockit
DB_ROOT_PASSWORD=rootclockit
DB_PORT=3307
WEB_PORT=8090
# Gebruik in productie een lange willekeurige waarde, bv. uit: openssl rand -hex 32
JWT_SECRET=dev-secret-verander-mij
COOKIE_SECURE=false
